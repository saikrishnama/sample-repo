
"""
Confluence RAG using Databricks Embeddings and ChromaDB.

This script:
1. Reads pages from a Confluence space.
2. Cleans page content and ignores empty pages.
3. Splits useful text into smaller chunks.
4. Creates embeddings through Databricks.
5. Stores the embeddings in a local ChromaDB database.
6. Retrieves relevant documentation for a question.

No sentence-transformers or PyTorch dependency is required.
"""

import os
import re
import hashlib
import argparse

import requests
import chromadb

from bs4 import BeautifulSoup
from dotenv import load_dotenv


# ---------------------------------------------------------
# Load configuration
# ---------------------------------------------------------

load_dotenv()

CONFLUENCE_URL = os.getenv(
    "CONFLUENCE_URL", ""
).rstrip("/")

CONFLUENCE_EMAIL = os.getenv(
    "CONFLUENCE_EMAIL", ""
)

CONFLUENCE_API_TOKEN = os.getenv(
    "CONFLUENCE_API_TOKEN", ""
)

CONFLUENCE_SPACE_KEY = os.getenv(
    "CONFLUENCE_SPACE_KEY", ""
)

DATABRICKS_HOST = os.getenv(
    "DATABRICKS_HOST", ""
).rstrip("/")

DATABRICKS_TOKEN = os.getenv(
    "DATABRICKS_TOKEN", ""
)

DATABRICKS_EMBEDDING_ENDPOINT = os.getenv(
    "DATABRICKS_EMBEDDING_ENDPOINT", ""
)

CHROMA_FOLDER = os.getenv(
    "CHROMA_FOLDER", "./confluence_chroma"
)

CHROMA_COLLECTION = os.getenv(
    "CHROMA_COLLECTION", "confluence_onboarding"
)

CHUNK_WORDS = int(
    os.getenv("CHUNK_WORDS", "180")
)

CHUNK_OVERLAP = int(
    os.getenv("CHUNK_OVERLAP", "35")
)

EMBEDDING_BATCH_SIZE = int(
    os.getenv("EMBEDDING_BATCH_SIZE", "32")
)

REQUEST_TIMEOUT = 45


# ---------------------------------------------------------
# Check configuration
# ---------------------------------------------------------

def check_settings():
    """Check that the required settings are available."""

    required_settings = {
        "CONFLUENCE_URL": CONFLUENCE_URL,
        "CONFLUENCE_EMAIL": CONFLUENCE_EMAIL,
        "CONFLUENCE_API_TOKEN": CONFLUENCE_API_TOKEN,
        "CONFLUENCE_SPACE_KEY": CONFLUENCE_SPACE_KEY,
        "DATABRICKS_HOST": DATABRICKS_HOST,
        "DATABRICKS_TOKEN": DATABRICKS_TOKEN,
        "DATABRICKS_EMBEDDING_ENDPOINT":
            DATABRICKS_EMBEDDING_ENDPOINT,
    }

    missing_settings = [
        name
        for name, value in required_settings.items()
        if not value
    ]

    if missing_settings:
        raise ValueError(
            "Please configure these settings in .env: "
            + ", ".join(missing_settings)
        )

    if CHUNK_WORDS <= 0:
        raise ValueError("CHUNK_WORDS must be greater than zero.")

    if not 0 <= CHUNK_OVERLAP < CHUNK_WORDS:
        raise ValueError(
            "CHUNK_OVERLAP must be smaller than CHUNK_WORDS."
        )

    if EMBEDDING_BATCH_SIZE <= 0:
        raise ValueError(
            "EMBEDDING_BATCH_SIZE must be greater than zero."
        )


# ---------------------------------------------------------
# Connect to Confluence
# ---------------------------------------------------------

def create_confluence_session():
    """Create a session for reading Confluence pages."""

    confluence_session = requests.Session()

    confluence_session.auth = (
        CONFLUENCE_EMAIL,
        CONFLUENCE_API_TOKEN,
    )

    confluence_session.headers.update({
        "Accept": "application/json"
    })

    return confluence_session


def get_confluence_pages(confluence_session):
    """Read all current pages in the configured space."""

    api_url = (
        f"{CONFLUENCE_URL}/wiki/rest/api/content"
    )

    all_pages = []
    start_at = 0
    page_size = 100

    while True:
        params = {
            "spaceKey": CONFLUENCE_SPACE_KEY,
            "type": "page",
            "status": "current",
            "limit": page_size,
            "start": start_at,
            "expand": "body.storage,version,space",
        }

        response = confluence_session.get(
            api_url,
            params=params,
            timeout=REQUEST_TIMEOUT,
        )

        response.raise_for_status()

        page_data = response.json()
        current_pages = page_data.get("results", [])

        all_pages.extend(current_pages)

        print(
            f"Retrieved {len(all_pages)} pages so far."
        )

        if len(current_pages) < page_size:
            break

        start_at += len(current_pages)

    return all_pages


# ---------------------------------------------------------
# Clean page content
# ---------------------------------------------------------

def clean_page_content(page_html):
    """
    Convert HTML to readable text.

    Ignore empty content, extra spaces, repeated line breaks,
    and content that contains only whitespace.
    """

    if not page_html or not page_html.strip():
        return ""

    soup = BeautifulSoup(page_html, "html.parser")

    # Remove elements that should not be included in the text.
    for tag in soup([
        "script",
        "style",
        "noscript",
        "svg",
    ]):
        tag.decompose()

    # Keep separate paragraphs, headings, list items, and rows
    # so the resulting text remains easier to understand.
    for tag in soup.find_all([
        "p",
        "div",
        "li",
        "tr",
        "h1",
        "h2",
        "h3",
        "h4",
        "br",
    ]):
        tag.append("\n")

    page_text = soup.get_text(separator=" ", strip=True)

    # Normalize whitespace without changing the actual words.
    page_text = re.sub(r"[ \t\r\f\v]+", " ", page_text)
    page_text = re.sub(r"\s*\n\s*", "\n", page_text)
    page_text = re.sub(r"\n{2,}", "\n", page_text)

    # Remove blank lines and whitespace-only content.
    useful_lines = [
        line.strip()
        for line in page_text.splitlines()
        if line.strip()
    ]

    return "\n".join(useful_lines).strip()


# ---------------------------------------------------------
# Prepare page information
# ---------------------------------------------------------

def get_page_url(page):
    """Build the link a user can open to view a page."""

    web_link = page.get("_links", {}).get("webui")

    if web_link:
        if web_link.startswith("http"):
            return web_link

        return f"{CONFLUENCE_URL}{web_link}"

    return (
        f"{CONFLUENCE_URL}/wiki/pages/"
        f"viewpage.action?pageId={page['id']}"
    )


def prepare_page_record(page):
    """Extract the title, content, version, and URL."""

    page_id = str(page["id"])

    page_title = (
        page.get("title") or "Untitled page"
    ).strip()

    page_version = (
        page.get("version") or {}
    ).get("number", 0)

    page_html = (
        page.get("body", {})
        .get("storage", {})
        .get("value", "")
    )

    page_text = clean_page_content(page_html)

    # Ignore pages that contain no useful text.
    if not page_text:
        return None

    content_hash = hashlib.sha256(
        page_text.encode("utf-8")
    ).hexdigest()

    return {
        "page_id": page_id,
        "title": page_title,
        "version": page_version,
        "url": get_page_url(page),
        "content": page_text,
        "content_hash": content_hash,
    }


# ---------------------------------------------------------
# Split content into chunks
# ---------------------------------------------------------

def split_text_into_chunks(
    page_text,
    chunk_words=CHUNK_WORDS,
    overlap_words=CHUNK_OVERLAP,
):
    """Split useful text into overlapping chunks."""

    words = page_text.split()

    if not words:
        return []

    step_size = chunk_words - overlap_words
    chunks = []

    for start in range(0, len(words), step_size):
        chunk = " ".join(
            words[start:start + chunk_words]
        ).strip()

        # Do not store empty or whitespace-only chunks.
        if chunk:
            chunks.append(chunk)

        if start + chunk_words >= len(words):
            break

    return chunks


def prepare_document_chunks(page_records):
    """Turn pages into chunks that can be stored in ChromaDB."""

    all_chunks = []

    for page in page_records:
        page_chunks = split_text_into_chunks(
            page["content"]
        )

        for chunk_number, chunk_text in enumerate(
            page_chunks
        ):
            chunk_id = (
                f"{page['page_id']}_"
                f"{page['content_hash'][:12]}_"
                f"{chunk_number}"
            )

            all_chunks.append({
                "id": chunk_id,
                "text": chunk_text,
                "metadata": {
                    "page_id": page["page_id"],
                    "title": page["title"],
                    "version": str(page["version"]),
                    "url": page["url"],
                    "chunk_number": chunk_number,
                    "content_hash": page["content_hash"],
                },
            })

    return all_chunks


# ---------------------------------------------------------
# Create embeddings through Databricks
# ---------------------------------------------------------

class DatabricksEmbeddingService:
    """Generate embeddings using a Databricks serving endpoint."""

    def __init__(self):
        self.session = requests.Session()

        self.session.headers.update({
            "Authorization": f"Bearer {DATABRICKS_TOKEN}",
            "Content-Type": "application/json",
        })

        self.endpoint_url = (
            f"{DATABRICKS_HOST}/serving-endpoints/"
            f"{DATABRICKS_EMBEDDING_ENDPOINT}/invocations"
        )

    def create_embeddings(self, texts):
        """Return one embedding vector for every input text."""

        if not texts:
            return []

        all_vectors = []

        for batch_start in range(
            0, len(texts), EMBEDDING_BATCH_SIZE
        ):
            text_batch = texts[
                batch_start:
                batch_start + EMBEDDING_BATCH_SIZE
            ]

            response = self.session.post(
                self.endpoint_url,
                json={"input": text_batch},
                timeout=REQUEST_TIMEOUT,
            )

            response.raise_for_status()

            response_data = response.json()

            # Support the OpenAI-compatible embedding response.
            if isinstance(response_data.get("data"), list):
                batch_vectors = [
                    item["embedding"]
                    for item in response_data["data"]
                ]

            # Also support endpoints returning an embeddings array.
            elif isinstance(
                response_data.get("embeddings"), list
            ):
                batch_vectors = response_data["embeddings"]

            else:
                raise ValueError(
                    "The Databricks response format was not "
                    "recognized. Check the endpoint's API format."
                )

            if len(batch_vectors) != len(text_batch):
                raise ValueError(
                    "The endpoint returned a different number "
                    "of vectors than the number of input texts."
                )

            if any(
                not isinstance(vector, list) or not vector
                for vector in batch_vectors
            ):
                raise ValueError(
                    "The endpoint returned an empty or invalid vector."
                )

            vector_sizes = {
                len(vector) for vector in batch_vectors
            }

            if len(vector_sizes) != 1:
                raise ValueError(
                    "The embedding vectors have inconsistent dimensions."
                )

            all_vectors.extend(batch_vectors)

        return all_vectors


# ---------------------------------------------------------
# Open the local ChromaDB collection
# ---------------------------------------------------------

def open_document_collection():
    """Open the persistent local vector database."""

    chroma_client = chromadb.PersistentClient(
        path=CHROMA_FOLDER
    )

    collection = chroma_client.get_or_create_collection(
        name=CHROMA_COLLECTION,
        metadata={
            "description": "Confluence documentation chunks"
        },
    )

    return chroma_client, collection


# ---------------------------------------------------------
# Refresh the Confluence search index
# ---------------------------------------------------------

def sync_confluence_pages():
    """
    Fetch the current pages, create embeddings, and refresh
    the local index after the new embeddings are ready.
    """

    check_settings()

    confluence_session = create_confluence_session()

    print("\nReading pages from Confluence...")

    raw_pages = get_confluence_pages(
        confluence_session
    )

    print(f"\nTotal pages retrieved: {len(raw_pages)}")

    page_records = []
    skipped_pages = 0

    for page in raw_pages:
        page_record = prepare_page_record(page)

        if page_record is None:
            skipped_pages += 1
            continue

        page_records.append(page_record)

    print(f"Pages with useful text: {len(page_records)}")
    print(f"Empty pages skipped: {skipped_pages}")

    chunks = prepare_document_chunks(page_records)

    print(f"Chunks prepared: {len(chunks)}")

    # Prepare the new vectors before deleting the old index.
    # This avoids clearing the current index if embedding fails.
    embedder = DatabricksEmbeddingService()
    indexed_batches = []

    for batch_start in range(
        0, len(chunks), EMBEDDING_BATCH_SIZE
    ):
        chunk_batch = chunks[
            batch_start:
            batch_start + EMBEDDING_BATCH_SIZE
        ]

        chunk_texts = [
            chunk["text"] for chunk in chunk_batch
        ]

        vectors = embedder.create_embeddings(chunk_texts)

        indexed_batches.append({
            "chunks": chunk_batch,
            "vectors": vectors,
        })

        print(
            f"Prepared embeddings for "
            f"{min(batch_start + len(chunk_batch), len(chunks))}"
            f" of {len(chunks)} chunks."
        )

    # Confirm all new vectors have the same dimensions.
    vector_dimensions = {
        len(vector)
        for batch in indexed_batches
        for vector in batch["vectors"]
    }

    if len(vector_dimensions) > 1:
        raise ValueError(
            "The embedding endpoint returned inconsistent "
            "vector dimensions across batches."
        )

    _, collection = open_document_collection()

    # Save the new index after embedding creation succeeds.
    # Delete existing records in batches to handle large indexes.
    existing_count = collection.count()

    while existing_count:
        existing_records = collection.get(
            limit=min(existing_count, 5000),
            include=[],
        )

        old_ids = existing_records.get("ids", [])

        if not old_ids:
            break

        collection.delete(ids=old_ids)
        existing_count = collection.count()

    # Add the freshly indexed chunks.
    for batch in indexed_batches:
        chunk_batch = batch["chunks"]
        vectors = batch["vectors"]

        collection.upsert(
            ids=[
                chunk["id"] for chunk in chunk_batch
            ],
            documents=[
                chunk["text"] for chunk in chunk_batch
            ],
            embeddings=vectors,
            metadatas=[
                chunk["metadata"] for chunk in chunk_batch
            ],
        )

    print("\nConfluence indexing completed.")
    print(f"Pages indexed: {len(page_records)}")
    print(f"Chunks stored: {collection.count()}")


# ---------------------------------------------------------
# Search for relevant documentation
# ---------------------------------------------------------

def search_relevant_pages(question, number_of_results=5):
    """Find the Confluence chunks most relevant to a question."""

    check_settings()

    _, collection = open_document_collection()

    total_chunks = collection.count()

    if total_chunks == 0:
        print(
            "The search index is empty. "
            "Run python confluence_rag.py --sync first."
        )
        return []

    embedder = DatabricksEmbeddingService()

    question_vector = embedder.create_embeddings(
        [question]
    )[0]

    # Make sure the question uses the same vector dimensions
    # as the documents already stored in the collection.
    stored_record = collection.get(
        limit=1,
        include=["embeddings"],
    )

    stored_embeddings = stored_record.get("embeddings")

    if (
        stored_embeddings is not None
        and len(stored_embeddings) > 0
        and len(question_vector) != len(stored_embeddings[0])
    ):
        raise ValueError(
            "The question embedding dimensions do not match "
            "the stored document embeddings. Re-index using "
            "the same Databricks embedding model."
        )

    results = collection.query(
        query_embeddings=[question_vector],
        n_results=min(number_of_results, total_chunks),
        include=[
            "documents",
            "metadatas",
            "distances",
        ],
    )

    matched_pages = []

    documents = (results.get("documents") or [[]])[0]
    metadata_rows = (results.get("metadatas") or [[]])[0]
    distances = (results.get("distances") or [[]])[0]

    for index, document_text in enumerate(documents):
        matched_pages.append({
            "text": document_text,
            "metadata": metadata_rows[index],
            "distance": (
                distances[index]
                if index < len(distances)
                else None
            ),
        })

    return matched_pages


# ---------------------------------------------------------
# Display the retrieved content
# ---------------------------------------------------------

def show_search_results(question, number_of_results=5):
    """Print the matching documentation in a readable format."""

    matches = search_relevant_pages(
        question,
        number_of_results,
    )

    if not matches:
        print(
            "I couldn't find this information in the "
            "Confluence documentation."
        )
        return

    print(f"\nQuestion: {question}")
    print("\nRelevant Confluence documentation:")

    for result_number, match in enumerate(matches, start=1):
        metadata = match["metadata"]

        print("\n" + "=" * 80)
        print(f"Result: {result_number}")
        print(f"Title: {metadata.get('title', '')}")
        print(f"URL: {metadata.get('url', '')}")
        print(f"Distance: {match['distance']}")
        print("-" * 80)
        print(match["text"])

    print("\nUse only the retrieved documentation to answer.")
    print(
        "If the evidence does not answer the question, use: "
        "\"I couldn't find this information in the "
        "Confluence documentation.\""
    )


# ---------------------------------------------------------
# Start the program
# ---------------------------------------------------------

def main():
    """Run indexing or search based on the command-line option."""

    parser = argparse.ArgumentParser(
        description=(
            "Search Confluence documentation using "
            "Databricks embeddings and local ChromaDB."
        )
    )

    parser.add_argument(
        "--sync",
        action="store_true",
        help="Refresh the local Confluence search index.",
    )

    parser.add_argument(
        "--ask",
        type=str,
        help="Search the index with a question.",
    )

    parser.add_argument(
        "--results",
        type=int,
        default=5,
        help="Number of matching chunks to retrieve.",
    )

    args = parser.parse_args()

    if args.results < 1:
        parser.error("--results must be at least 1.")

    if args.sync:
        sync_confluence_pages()

    elif args.ask:
        show_search_results(
            args.ask,
            args.results,
        )

    else:
        parser.print_help()


if __name__ == "__main__":
    main()



